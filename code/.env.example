# 复制本文件为 .env 并填入你自己的 key。examples/_config.py 会自动加载。
#
# 选一个 provider,设置 TINYAGENT_MODEL = "provider:model",再填对应的 key。
# 注意:主线示例全部可用 FakeModel 离线运行,不配 key 也能学完机制部分。

# —— 用 Anthropic(Claude)——
TINYAGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...

# —— 用 DeepSeek(OpenAI 兼容)——
# TINYAGENT_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# —— 用 OpenAI ——
# TINYAGENT_MODEL=openai:gpt-5.1
# OPENAI_API_KEY=sk-...

# —— 用通义千问 Qwen ——
# TINYAGENT_MODEL=qwen:qwen-plus
# DASHSCOPE_API_KEY=sk-...

# —— 用 Kimi(Moonshot)——
# TINYAGENT_MODEL=kimi:moonshot-v1-8k
# MOONSHOT_API_KEY=sk-...

# —— 本地 / 自建 OpenAI 兼容网关 ——
# TINYAGENT_MODEL=local:qwen3-32b
# (需要 base_url:init_chat_model("local:qwen3-32b", base_url="http://localhost:8000/v1"))
